rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Complaint evidence: complaints/{uid}/{uploadId}/{fileName}
    // Only the owner can upload (images up to 5MB) or read via the SDK.
    // Staff view evidence through the tokenised download URLs stored on the
    // complaint, which Firestore rules already restrict.
    match /complaints/{uid}/{uploadId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
