# JanNivaran environment variables
# Copy to .env.local and fill in values. Never commit .env.local or service-account keys.

# --- Firebase web app (public; Firebase console > Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Public base URL used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Firebase Admin (server only; service account) ---
# API routes return 503 when these are missing.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=service-account@your_project_id.iam.gserviceaccount.com
# Keep the quotes; newlines may be written as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# --- Email (optional; without SMTP credentials emails are reported as "skipped") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
# Testing: send ALL outgoing mail to this inbox instead of real citizens
EMAIL_OVERRIDE_TO=
